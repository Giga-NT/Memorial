// ==================== КЭШ МАТЕРИАЛОВ ====================
const materialCache = new Map();

async function getCachedMaterial(materialType) {
    if (materialCache.has(materialType)) {
        return materialCache.get(materialType);
    }
    const material = await loadPBRMaterial(materialType);
    materialCache.set(materialType, material);
    return material;
}

