    `;
}


function animate() {
    requestAnimationFrame(animate);
    controls.update();
    
    // Обновляем выделение мебели
    if (furniture3DManager) {
        furniture3DManager.update();
    }
    
    renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});

// ==================== ОТПРАВКА ЗАКАЗА ====================

document.getElementById('sendOrderBtn')?.addEventListener('click', async function() {
    const statusDiv = document.getElementById('orderStatus');
    
    // Проверяем заполнение
    const name = document.getElementById('clientName')?.value.trim();
    const phone = document.getElementById('clientPhone')?.value.trim();
    
    if (!name || !phone) {
        statusDiv.style.color = '#ef4444';
        statusDiv.textContent = '❌ Заполните имя и телефон!';
        return;
    }
    
    // Собираем данные
    const orderData = {
        clientName: name,
        clientPhone: phone,
        clientEmail: document.getElementById('clientEmail')?.value.trim() || '',
        comment: document.getElementById('orderComment')?.value.trim() || '',
        
        // Параметры памятника
        steleWidth: state.width,
        steleHeight: state.height,
        steleMaterial: state.material,
        fullName: state.fullName,
        dates: state.dates,
        epitaph: state.epitaph,
        
        // Цветник
        flowerWidth: state.flowerWidth,
        flowerLength: state.flowerLength,
        flowerbedType: state.flowerbedType,
        
        // Оградка
        fenceType: state.fenceType,
        fenceHeight: state.fenceHeight,
        fenceMaterial: state.fenceMaterial,
        fenceGateSide: state.fenceGateSide,
        
        // Цены
        totalPrice: calculatePrice(),
        stelePrice: 0, // можно добавить расчет
        flowerPrice: 0,
        fencePrice: 0,
        deliveryPrice: parseInt(localStorage.getItem('priceDelivery') || 3000),
        installPrice: parseInt(localStorage.getItem('priceInstall') || 5000)
    };
    
    // Делаем скриншот
    try {
        renderer.render(scene, camera);
        const screenshot = renderer.domElement.toDataURL('image/jpeg', 0.7);
        orderData.screenshot = screenshot;
    } catch(e) {
        console.warn('Скриншот не создан');
    }
    
    // Отправляем на сервер
    statusDiv.style.color = '#fbbf24';
    statusDiv.textContent = '⏳ Отправка заказа...';
    this.disabled = true;
    
    try {
        const response = await fetch('send-order.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(orderData)
        });
        
        const result = await response.json();
        
        if (result.success) {
            statusDiv.style.color = '#4ade80';
            statusDiv.textContent = '✅ ' + result.message;
            // Очищаем форму
            document.getElementById('clientName').value = '';
            document.getElementById('clientPhone').value = '';
            document.getElementById('clientEmail').value = '';
            document.getElementById('orderComment').value = '';
        } else {
            statusDiv.style.color = '#ef4444';
            statusDiv.textContent = '❌ ' + result.message;
        }
    } catch(error) {
        statusDiv.style.color = '#ef4444';
        statusDiv.textContent = '❌ Ошибка отправки. Попробуйте позже или позвоните нам.';
    }
    
    this.disabled = false;
});

// ============================================================
// ФИКС СКРОЛЛА МЕНЮ НА iOS (КОНФЛИКТ С THREE.JS)
// ============================================================

// Функция для принудительной активации скролла
function fixMenuScroll() {
    const menuScroll = document.getElementById('menuScroll');
    if (!menuScroll) return;
    
    // Принудительно включаем скролл
    menuScroll.style.overflow = 'scroll';
    menuScroll.style.overflowY = 'scroll';
    menuScroll.style.webkitOverflowScrolling = 'touch';
    menuScroll.style.touchAction = 'pan-y';
    
    // Добавляем пустой обработчик для активации touch-событий на iOS
    menuScroll.addEventListener('touchstart', function() {}, { passive: true });
}

// Следим за открытием меню
const menuObserver = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
            const menu = document.getElementById('accordionMenu');
            if (menu && menu.classList.contains('open')) {
                // Меню открыто - активируем скролл
                setTimeout(function() {
                    const scroll = document.getElementById('menuScroll');
                    if (scroll) {
                        // iOS трюк - скроллим на 1px чтобы "разбудить" скролл
                        scroll.scrollTop = 1;
                        setTimeout(function() {
                            scroll.scrollTop = 0;
                        }, 10);
                    }
                }, 100);
            }
        }
    });
});

// Запускаем наблюдатель
const menu = document.getElementById('accordionMenu');
if (menu) {
    menuObserver.observe(menu, { attributes: true, attributeFilter: ['class'] });
}

// Вызываем при загрузке
document.addEventListener('DOMContentLoaded', fixMenuScroll);
setTimeout(fixMenuScroll, 500);

console.log('✅ Фикс скролла меню активирован');


// ===== ДЛЯ МОБИЛЬНОГО УПРАВЛЕНИЯ =====
// Сохраняем controls в глобальную переменную
window.controls = controls;

// При открытии меню - отключаем controls
document.addEventListener('menuOpened', function() {
    controls.enabled = false;
});

document.addEventListener('menuClosed', function() {
    controls.enabled = true;
});

